# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it holds secrets.

ENV=development
SERVER_ADDRESS=:8080
CORS_ALLOWED_ORIGIN=http://localhost:5174
DB_DRIVER=postgres
DB_SOURCE=postgres://user:password@localhost:5432/daily_dashboard?sslmode=disable
JWT_SECRET=replace_with_a_long_random_secret
